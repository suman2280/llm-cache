# Copy to .env (which is gitignored) and edit. Everything has a working default.

# ---- http ---------------------------------------------------------------
PORT=8000
HOST=127.0.0.1

# ---- upstream model -----------------------------------------------------
# llama-server's OpenAI-compatible endpoint. Start it with scripts/run_model.sh
# (or let the app spawn it -- see MODEL_IDLE_S below).
UPSTREAM_URL=http://127.0.0.1:8080
UPSTREAM_KEY=local-dev-key
MODEL_ID=qwen2.5-7b-instruct
MODEL_TIMEOUT_MS=300000
# Retry a transient "fetch failed" (model recycled mid-request) after a fresh
# health check / respawn. 2 retries = up to 3 attempts.
MODEL_FETCH_RETRIES=2

# The model supervisor: spawn on a real miss, kill when idle.
#   0    unload immediately after every request (maximum memory saving)
#   120  unload after 2 idle minutes (default)
#   -1   never unload (minimum latency, model stays resident)
MODEL_IDLE_S=120

# Paths are appended by scripts/setup_model.sh -- leave these commented out.
# Node's --env-file does not expand "~", so the setup script writes absolute
# paths. If you copy this file by hand, the code still resolves all three
# from the checkout and your home directory.
# LLAMA_SERVER_BIN=/path/to/llama.cpp/build/bin/llama-server
# MODEL_GGUF=/path/to/repo/models/qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf
# MODEL_ADAPTER=/path/to/repo/models/lora/aws-adapter.gguf
MODEL_CTX=2048
MODEL_THREADS=12
# #68: llama.cpp reuses the KV cache of a matching prompt prefix (the shared
# system prompt + RAG preamble) across requests. Set 0 to disable.
MODEL_CACHE_PROMPT=1

# ---- redis (vector index for the semantic tier only) -------------------
REDIS_URL=redis://127.0.0.1:6379/0
# Cosine radius. Deliberately tight -- the verifier, not the radius, is the
# safety mechanism. See docs/REBUILD.md.
DISTANCE_THRESHOLD=0.35

# ---- sqlite (durable cache, provenance, review state, events) ----------
DB_PATH=./data/llm-cache.sqlite

# ---- grounding ----------------------------------------------------------
# The model card credits the fine-tune with "grounded, accurate responses",
# but attributes that to a FAISS RAG layer that is NOT part of the checkpoint.
# Without grounding the model answers from memory and produces generic text
# ("What are virtual machines?" came back with no mention of EC2). Reference
# chunks are retrieved from knowledge/aws-knowledge.json and folded into the
# system prompt.
GROUNDING_TOP_K=3
# Floor on the answer length.
MAX_ANSWER_TOKENS=400
# Start the assistant turn at "Key points:" so the model continues from a bullet
# list instead of choosing to write one tight paragraph. Measured: 236 tokens
# with the prefill, 65 without -- and instructions alone ("write at least 200
# words", "use bullet points") are ignored by this 7B.
ANSWER_PREFILL=1

# ---- anti-repetition sampling -------------------------------------------
# A 7B on a CPU sometimes falls into a repetition loop and emits one line over
# and over ("s3 HTTPS encryption" produced the same bullet 15 times). These
# stop it; the caller may override any of them per request.
FREQUENCY_PENALTY=0.4
PRESENCE_PENALTY=0.3
# repeat_penalty and DRY are OFF by default: they penalise any repeated token
# sequence, and a bullet list inherently repeats phrasing, so they cut the
# answer from 392 tokens to 81. Raise them if you see repetition loops.
REPEAT_PENALTY=1.0
DRY_MULTIPLIER=0.0
DRY_BASE=1.75
DRY_ALLOWED_LENGTH=2
DRY_PENALTY_LAST_N=64
# A degenerate answer is retried with a hotter sample and a different seed; if
# it still degenerates it is NOT cached and the request fails.
DEGENERATE_RETRIES=1

# ---- domain guard -------------------------------------------------------
# The fine-tune's model card promises it refuses out-of-domain questions
# ("100% correct refusal"). Measured, it does not -- 0 of 6 -- so the proxy
# enforces it. The domain itself comes from the loaded corpus (src/corpus.js).
#   strict  refuse out-of-domain requests with 422   (default)
#   bypass  answer them, label them, but NEVER cache them
#   off     no restriction
DOMAIN_MODE=strict

# ---- governance ---------------------------------------------------------
# Only entries at/above this review_status are served to non-author callers.
MIN_REVIEW_STATUS=approved
# Authorizes the /cache/* invalidation endpoints and /content/records/:id/review.
# /stats/reset stays open (it can only zero counters); on a loopback bind a
# same-origin browser request is also accepted so the dashboard works. On any
# non-loopback bind the token is the sole authority.
ADMIN_TOKEN=dev-token
# Second, DISTINCT approver for production release (two-person gate). Keep it
# empty to make production promotion impossible from one principal alone.
REVIEWER_TOKEN=
# Required for POST /demo/seed (seeds the demonstration corpus). scripts/dev.sh
# sets it to 1; a plain `npm start` does not, so `npm run seed` would 404.
ALLOW_SEED=0

# ---- error budget ---------------------------------------------------------
# #37: declared target false-positive rate. Per-origin coverage thresholds
# are in src/cache.js; the measured rate comes from scripts/bench_cache.mjs.
TARGET_FPR=0.01

# ---- tenancy / admission --------------------------------------------------
# #33: single-tenant PoC. A real deployment must derive this from auth.
TENANT_ID=local
# #14: cap expensive generations per client per minute.
MAX_INFERENCES_PER_MINUTE=20
# #34: only trusted callers (admin token or same-origin loopback) may write
# shared cache entries. Others get an answer but it is quarantined.
TRUSTED_WRITES_ONLY=0

# ---- cache size / lifetime ------------------------------------------------
# #36: LRU cap across both SQLite and Redis. 0 disables the cap.
MAX_ENTRIES=5000
# #9: age-based invalidation in seconds. 0 disables TTL.
CACHE_TTL_S=0

# ---- observability ------------------------------------------------------
STATS_EVENT_LIMIT=100
SERVICE_NAME=llm-cache
SERVICE_VERSION=0.2.0
# Unload the embedder when the semantic tier stays unused this long.
EMBEDDER_IDLE_S=300

# ---- pluggable embedder (#67) --------------------------------------------
# Provider (transformers) and model id. VECTOR_DIM MUST match the model's
# output width; changing either requires: node scripts/reindex_vectors.mjs
EMBEDDER_PROVIDER=transformers
EMBEDDER_MODEL=Xenova/all-MiniLM-L6-v2
VECTOR_DIM=384

# ---- negative cache (#65) -------------------------------------------------
# How long out-of-domain refusals are remembered (0 disables). Cleared on
# corpus/KB invalidation.
NEGATIVE_CACHE_TTL_S=300

# ---- optional reranker (#64) ----------------------------------------------
# off = unchanged behaviour; onnx = lazy cross-encoder second-stage scorer.
VERIFIER_RERANKER=off
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_THRESHOLD=0.5
RERANKER_IDLE_S=300

# ---- warming & observability (#63, #66) -----------------------------------
WARM_CONCURRENCY=2
COST_PER_TOKEN_USD=0.000002
BREAKDOWN_LIMIT=10