{
  "name": "llm-cache",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A governed LLM response cache: requests should avoid the model. Built as a preview for the JEE AI Tutor content-creation SOP; the frozen dashboard is the spec.",
  "scripts": {
    "start": "node src/main.js",
    "seed": "node scripts/seed_corpus.mjs",
    "demo": "node scripts/demo_preview.mjs",
    "bench:model": "node scripts/bench_model.mjs",
    "contract": "node scripts/check_api_contract.mjs",
    "test": "node --test dashboard/ tests/",
    "check:dashboard": "python3 scripts/check_dashboard.py"
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "redis": "^4.7.1",
    "@xenova/transformers": "^2.17.2"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "sharp@0.32.6": true,
    "protobufjs@6.11.6": true
  }
}
